#!/usr/bin/env bash
# @brief The command line entry point for the PixiEden runtime.
# @description
# The CLI core that interprets and executes commands.
# Path resolution and state management are delegated to the libraries under lib.

PIXIED_VERSION="0.4.0"
readonly PIXIED_VERSION

# Get the absolute path to the pixied binary, resolving any symlinks
# manually for systems that don't support `readlink -f`.
PIXIED_SOURCE=${BASH_SOURCE[0]}
while [ -L "$PIXIED_SOURCE" ]; do
    PIXIED_LINK_DIR=$(cd "$(dirname "$PIXIED_SOURCE")" && pwd)
    PIXIED_SOURCE=$(readlink "$PIXIED_SOURCE")
    case "$PIXIED_SOURCE" in
    /*) ;;
    *) PIXIED_SOURCE="$PIXIED_LINK_DIR/$PIXIED_SOURCE" ;;
    esac
done
PIXIED_BIN_DIR=$(cd "$(dirname "$PIXIED_SOURCE")" && pwd)
readonly PIXIED_BIN_DIR
PIXIED_ROOT=$(cd "$PIXIED_BIN_DIR/.." && pwd)
readonly PIXIED_ROOT

# shellcheck source=lib/common.sh
. "$PIXIED_ROOT/lib/common.sh"
# shellcheck source=lib/paths.sh
. "$PIXIED_ROOT/lib/paths.sh"
# shellcheck source=lib/state.sh
. "$PIXIED_ROOT/lib/state.sh"
# shellcheck source=lib/lease.sh
. "$PIXIED_ROOT/lib/lease.sh"
# shellcheck source=lib/options.sh
. "$PIXIED_ROOT/lib/options.sh"
# shellcheck source=lib/pixi.sh
. "$PIXIED_ROOT/lib/pixi.sh"
# shellcheck source=lib/sync.sh
. "$PIXIED_ROOT/lib/sync.sh"
# shellcheck source=lib/session.sh
. "$PIXIED_ROOT/lib/session.sh"
# shellcheck source=lib/hook.sh
. "$PIXIED_ROOT/lib/hook.sh"
# shellcheck source=lib/generate.sh
. "$PIXIED_ROOT/lib/generate.sh"
# shellcheck source=lib/uninstall.sh
. "$PIXIED_ROOT/lib/uninstall.sh"
pixied_enable_strict_mode

# @description Print the usage and the list of available commands to standard output.
# @stdout The help message
pixied_usage() {
    cat <<'USAGE'
Usage: pixied [COMMAND]

Commands:
    (no command)           Alias for shell.
    shell [options]        Attach to the PixiEden session.
    run <command>          Run a command in the PixiEden runtime.
    install [options]      Install the dedicated Pixi environment and verify state.
    hook <shell> [options] Print shell initialization code.
    generate <format> [options] Generate a project integration file.
                           Formats: direnv, devcontainer, dockerfile.
    uninstall [options]    Remove the PixiEden installation.
    help                   Show this help.
    version                Print the PixiEden version.

Run `pixied <command> --help` for command options.
Runtime activation uses the dedicated Pixi environment and starts an isolated child process.
USAGE
}

# @description Print the shell subcommand usage to standard output.
# @stdout The shell command help message
pixied_shell_usage() {
    cat <<'USAGE'
Usage: pixied shell [--auto-attach auto|none]

Attach to the PixiEden session.

Runtime activation uses the dedicated Pixi environment and starts an isolated
child process.

Options:
    --auto-attach auto|none   (or PIXIED_AUTO_ATTACH=auto|none) controls whether the
                              interactive shell auto-attaches to Zellij. Use 'none' to
                              skip auto-attach and join manually with:
                              zellij attach --create pixied (default: auto)
USAGE
}

# @description Attach to the PixiEden session.
# Loads and validates the current machine state before starting an interactive
# child shell or attaching to the direct Zellij session. The --auto-attach flag
# or PIXIED_AUTO_ATTACH environment variable overrides the Zellij auto-attach.
# When --help is passed, prints the shell subcommand usage instead.
#
# @arg $@ string Runtime options.
# @exitcode 0 When the child shell or attach process exits successfully, or
# when the shell usage is printed.
# @exitcode The child or attach process exit status, including 128 plus the
# signal number when the process was terminated by a signal.
# @see pixied_shell_usage
pixied_shell() {
    pixied_options_parse_runtime "$@"
    if [ "${PIXIED_OPTIONS_HELP:-0}" -eq 1 ]; then
        pixied_shell_usage
        return "$PIXIED_EXIT_OK"
    fi
    if [ "${#PIXIED_RUNTIME_POSITIONAL[@]}" -gt 0 ]; then
        pixied_die "usage: pixied shell [--auto-attach auto|none]" "$PIXIED_EXIT_USAGE"
    fi
    pixied_runtime_shell
}

# @description Run a command in the PixiEden runtime.
# Explicit commands run directly without Zellij and without requiring a TTY.
#
# @arg $@ string The command and arguments to execute.
# @exitcode 0 When the command exits successfully.
# @exitcode The command exit status, including 128 plus the signal number when
# the process was terminated by a signal.
pixied_run_command() {
    [ "$#" -gt 0 ] || pixied_die "usage: pixied run <command> [args...]" "$PIXIED_EXIT_USAGE"
    pixied_runtime_run "$@"
}

# @description Print the hook subcommand usage to standard output.
# @stdout The hook command help message
pixied_hook_usage() {
    cat <<'USAGE'
Usage: pixied hook <bash|zsh> [--auto-attach auto|none]

Print shell initialization code for the PixiEden runtime.

Arguments:
    <shell>   The target shell: bash or zsh.

Options:
    --auto-attach auto|none   (or PIXIED_AUTO_ATTACH=auto|none) controls whether the
                              interactive hook auto-attaches to Zellij. When passed, the
                              resolved setting is baked into the generated runtime hook.
                              (default: auto)
USAGE
}

# @description Handle the hook that prints shell initialization code.
# Bash and zsh are supported. The runtime state and generated hook are
# validated before source code is emitted. When --auto-attach is passed, the
# runtime hook is regenerated so the resolved mode is baked into the sourced
# file and persisted with the updated hook hash. The regeneration holds the
# short state lock from pixied_state_lock_path across the hook write and the
# state write, then releases it. When the state write fails, the previous hook
# file is restored so no hash mismatch remains. When --help is passed, prints
# the hook subcommand usage instead.
#
# @arg $@ string The shell name and runtime options
# @exitcode 2 When the usage is invalid
# @exitcode 1 When the installation or generated hook is invalid
# @see pixied_hook_usage
# @see pixied_state_lock_path
# @see pixied_state_lock_acquire
# @see pixied_state_lock_release
pixied_hook() {
    local runtime_path hook_backup
    pixied_options_parse_runtime "$@"
    if [ "${PIXIED_OPTIONS_HELP:-0}" -eq 1 ]; then
        pixied_hook_usage
        return "$PIXIED_EXIT_OK"
    fi
    if [ "${#PIXIED_RUNTIME_POSITIONAL[@]}" -ne 1 ]; then
        pixied_die "usage: pixied hook <bash|zsh> [--auto-attach auto|none]" "$PIXIED_EXIT_USAGE"
    fi
    case "${PIXIED_RUNTIME_POSITIONAL[0]}" in
    bash | zsh) ;;
    *) pixied_die "usage: pixied hook <bash|zsh> [--auto-attach auto|none]" "$PIXIED_EXIT_USAGE" ;;
    esac
    pixied_runtime_load_state
    if [ "${PIXIED_OPTION_CLI_SET[auto_attach]:-0}" -eq 1 ]; then
        runtime_path=$(pixied_hook_runtime_path)
        hook_backup=""
        pixied_state_lock_acquire "$(pixied_state_lock_path)"
        if [ -f "$runtime_path" ] && [ ! -L "$runtime_path" ]; then
            hook_backup=$(pixied_run mktemp --tmpdir="${runtime_path%/*}" .pixied-hook-backup.XXXXXX)
            pixied_register_temp "$hook_backup"
            pixied_run cp -p -- "$runtime_path" "$hook_backup"
        fi
        pixied_hook_generate_runtime
        if ! (pixied_state_write "$PIXIED_STATE_FILE" >/dev/null 2>&1); then
            if [ -n "$hook_backup" ]; then
                pixied_run cp -p -- "$hook_backup" "$runtime_path" >/dev/null 2>&1
            else
                pixied_run rm -f -- "$runtime_path" >/dev/null 2>&1
            fi
            pixied_state_lock_release
            pixied_die "could not persist runtime hook state"
        fi
        pixied_state_lock_release
    fi
    pixied_hook_emit
}

# @description Warn and ask whether to continue when the resolved pixi home is
# not on a local filesystem.
# Runs after path resolution so that a forced local home mode or an explicit
# PIXIED_PIXI_HOME override that actually lands on a non-local filesystem is
# surfaced to the user. When stdin/stdout are not interactive TTYs, the warning
# is printed but the run continues without prompting so that automation is not
# blocked.
#
# @exitcode 0 When the pixi home is local, when continuing, or when no TTY is present
# @exitcode 1 When the user declines to continue
# @see pixied_is_local_filesystem
pixied_confirm_pixi_home() {
    if pixied_is_local_filesystem "$PIXIED_PIXI_HOME"; then
        return "$PIXIED_EXIT_OK"
    fi
    pixied_warn "resolved pixi home is not on a local filesystem: $PIXIED_PIXI_HOME"
    pixied_warn "running pixi from a non-local filesystem may be slow and unstable"
    if [ "${PIXIED_INSTALL_ASSUME_YES:-0}" -eq 1 ]; then
        return "$PIXIED_EXIT_OK"
    fi
    if ! [ -t 0 ] || ! [ -t 1 ]; then
        pixied_warn "no interactive TTY; continuing without confirmation"
        return "$PIXIED_EXIT_OK"
    fi
    printf '%sContinue anyway? [y/N] %s' "$PIXIED_COLOR_YELLOW" "$PIXIED_COLOR_RESET" >&2
    IFS= read -r answer
    case "$answer" in
    [yY] | [yY][eE][sS]) return "$PIXIED_EXIT_OK" ;;
    *) pixied_die "aborted by user after the non-local pixi home warning" ;;
    esac
}

# @description Print the install subcommand usage to standard output.
# @stdout The install command help message
pixied_install_usage() {
    cat <<'USAGE'
Usage: pixied install [OPTIONS]

Install the dedicated Pixi environment and verify state.

Options:
    --help                         Show this help.
    --yes                          Skip interactive confirmation prompts.
    --home-mode local|nfs          Select the account home mode.
    --local-home PATH              Set the machine-local home used by NFS mode.
    --session-manager none|zellij  Select the runtime session manager.
    --machine-id ID                Set the machine-specific state identifier.

Changing home mode, local home, session manager, or machine ID during
reinstall is rejected; run uninstall first.
USAGE
}

# @description Resolve PixiEden paths and create or verify state.
# With --help, prints the install usage and exits successfully.
# Otherwise resolves paths, creates the state directory, acquires the lock,
# and then loads or initializes and writes the state.
#
# @arg $@ string install options
# @exitcode 0 On success
# @exitcode 2 When an unknown option is given
# @exitcode 1 On failure
# @see pixied_resolve_paths
# @see pixied_state_lock_acquire
# @see pixied_state_load
# @see pixied_state_initialize_from_paths
# @see pixied_lease_sweep
# @see pixied_lease_other_active
pixied_install() {
    local state_exists=0 created_data=0 created_pixi_home=0

    pixied_install_state_checkpoint() {
        pixied_state_set pixi_binary_path "$PIXIED_PIXI_BINARY_PATH"
        pixied_state_set pixi_binary_hash "$PIXIED_PIXI_BINARY_HASH"
        pixied_state_set created_data "$created_data"
        pixied_state_set created_pixi_home "$created_pixi_home"
        pixied_state_write "$PIXIED_STATE_FILE"
    }

    pixied_options_parse "$@"
    if [ "${PIXIED_OPTIONS_HELP:-0}" -eq 1 ]; then
        pixied_install_usage
        return "$PIXIED_EXIT_OK"
    fi

    # Load the verified active runtime state. In an active runtime this sets the
    # identity and managed paths from the verified state file and refuses a
    # missing or unverifiable state; otherwise it is a no-op.
    pixied_state_bootstrap_active_runtime
    # Reject identity-changing options before any path resolution or state load.
    pixied_install_assert_active_identity

    pixied_options_apply_defaults
    pixied_resolve_paths 0
    pixied_require_cmd bash
    pixied_run bash --version >/dev/null

    if [ -e "$PIXIED_STATE_FILE" ] || [ -L "$PIXIED_STATE_FILE" ]; then
        pixied_state_load "$PIXIED_STATE_FILE"
        state_exists=1
        pixied_options_validate_state_transition
        pixied_options_apply_state
        pixied_resolve_paths
        pixied_state_assert_active_consistency
    else
        # Seed installation defaults from the most recently installed peer
        # machine so a fresh NFS host inherits a consistent configuration.
        pixied_options_apply_peer_defaults
    fi
    pixied_options_wizard "$state_exists"
    pixied_options_validate_state_transition
    pixied_resolve_paths
    pixied_confirm_pixi_home
    pixied_options_confirm_install

    pixied_step "Preparing the dedicated Pixi environment for $PIXIED_MACHINE_ID"
    pixied_run mkdir -p -- "$PIXIED_STATE_DIR" "$PIXIED_MACHINE_STATE_DIR" "$PIXIED_CONFIG_DIR"
    pixied_ensure_local_home_bin
    # The runtime no longer holds the state lock, so install always acquires a
    # fresh short lock; a real contention means another install/uninstall is
    # writing state and must remain a hard error. Afterwards, sweep stale
    # leases and warn (non-fatally) when a foreign runtime is still alive.
    # Ancestor-chain leases (this process's own runtime) are excluded so a
    # reinstall from inside a running shell stays quiet, matching uninstall.
    pixied_state_lock_acquire "$PIXIED_STATE_DIR/.lock"
    pixied_lease_sweep
    pixied_lease_other_active >/dev/null
    if [ "${PIXIED_LEASE_OTHER_COUNT:-0}" -gt 0 ]; then
        local lease_message="PixiEden is reinstalled while another runtime is active on this machine:"
        lease_message+=$'\n'
        lease_message+=$(pixied_lease_format_entries "${PIXIED_LEASE_OTHER_LIST[@]}")
        lease_message+=$'\nThe running runtime keeps its loaded environment; open a new shell or session to use the reinstalled files.'
        pixied_warn "$lease_message"
    fi
    if [ "$state_exists" -eq 1 ]; then
        pixied_state_load "$PIXIED_STATE_FILE"
        pixied_options_validate_state_transition
        pixied_options_apply_state
        pixied_resolve_paths
        pixied_state_assert_active_consistency
    else
        pixied_state_initialize_from_paths
    fi

    if [ -e "$PIXIED_DATA_DIR" ] || [ -L "$PIXIED_DATA_DIR" ]; then
        if [ "$state_exists" -eq 1 ] && pixied_state_has created_data; then
            created_data=${PIXIED_STATE[created_data]}
        else
            created_data=${PIXIED_DEPLOY_CREATED_DATA:-0}
        fi
    else
        created_data=1
    fi
    if [ -e "$PIXIED_PIXI_HOME" ] || [ -L "$PIXIED_PIXI_HOME" ]; then
        created_pixi_home=${PIXIED_STATE[created_pixi_home]:-0}
    else
        created_pixi_home=1
    fi
    pixied_pixi_validate_home_boundary "$created_pixi_home"

    pixied_state_set machine_id "$PIXIED_MACHINE_ID"
    pixied_state_set account_home "$PIXIED_ACCOUNT_HOME"
    pixied_state_set home_mode "$PIXIED_HOME_MODE"
    pixied_state_set local_home "$PIXIED_LOCAL_HOME"
    pixied_state_set session_manager "$PIXIED_SESSION_MANAGER"
    pixied_state_set data_dir "$PIXIED_DATA_DIR"
    pixied_state_set config_dir "$PIXIED_CONFIG_DIR"
    pixied_state_set state_dir "$PIXIED_STATE_DIR"
    pixied_state_set command_bin "$PIXIED_COMMAND_BIN"
    pixied_state_set pixi_home "$PIXIED_PIXI_HOME"
    pixied_pixi_install_binary
    if [ "${PIXIED_STATE[created_data]:-0}" -eq 1 ]; then
        created_data=1
    fi
    if [ "${PIXIED_STATE[created_pixi_home]:-0}" -eq 1 ]; then
        created_pixi_home=1
    fi
    pixied_install_state_checkpoint
    pixied_pixi_provision_globals
    pixied_state_set pixi_binary_path "$PIXIED_PIXI_BINARY_PATH"
    pixied_state_set pixi_binary_hash "$PIXIED_PIXI_BINARY_HASH"
    pixied_state_set direnv_path "$PIXIED_DIRENV_PATH"
    pixied_state_set direnv_hash "$(pixied_sha256_file "$PIXIED_DIRENV_PATH")"
    unset 'PIXIED_STATE[zellij_path]' 'PIXIED_STATE[zellij_hash]'
    if [ "$PIXIED_SESSION_MANAGER" = zellij ]; then
        pixied_state_set zellij_path "$PIXIED_ZELLIJ_PATH"
        pixied_state_set zellij_hash "$(pixied_sha256_file "$PIXIED_ZELLIJ_PATH")"
    fi
    pixied_state_set created_data "$created_data"
    pixied_state_set created_pixi_home "$created_pixi_home"
    pixied_hook_generate_runtime
    pixied_launcher_generate
    pixied_state_write "$PIXIED_STATE_FILE"
    pixied_state_lock_release
    if [ "$state_exists" -eq 1 ]; then
        pixied_info "Validated and repaired existing state: $PIXIED_STATE_FILE"
    else
        pixied_info "Created state: $PIXIED_STATE_FILE"
    fi
    pixied_success "Runtime hook, dedicated Pixi environment, and session support are ready"
    if [ "${PIXIED_ACTIVE_RUNTIME:-0}" = 1 ]; then
        pixied_info "Active runtime installation kept the verified identity intact. The current session keeps the previous environment until you restart or re-attach the runtime."
    fi
    pixied_print_next_steps
}

# @description Print the shell setup steps required after installation.
# The installer does not modify the user's shell configuration automatically.
# Option A recommends the bare command when the launcher is already on PATH and
# otherwise falls back to the absolute launcher path. Option B always references
# the deployed CLI body directly, keeping the generated hook self-contained and
# independent of whether ~/.local/bin is on PATH.
#
# @stderr The next-step instructions for starting or automatically enabling PixiEden
pixied_print_next_steps() {
    local launcher launcher_literal body body_literal start_cmd
    launcher="$PIXIED_COMMAND_BIN/pixied"
    printf -v launcher_literal '%q' "$launcher"
    if [ "${PIXIED_HOME_MODE:-local}" = nfs ]; then
        body=$launcher
    else
        body="$PIXIED_DATA_DIR/bin/pixied"
    fi
    printf -v body_literal '%q' "$body"
    if command -v pixied >/dev/null 2>&1; then
        start_cmd="pixied"
    else
        start_cmd="$launcher_literal"
    fi
    cat >&2 <<EOF
[pixied] NEXT Start PixiEden now or enable it automatically:

Option A (Start now):
  Run this command:
    $start_cmd shell

Option B (Automatic - Recommended):
  Add to ~/.bashrc, then restart your terminal:
    if [ -x $body_literal ]; then
        eval "\$($body_literal hook bash)"
    fi
  For zsh, add the equivalent block to ~/.zshrc and use hook zsh.
EOF
}

# @description Remove the current machine's PixiEden installation.
# Validates ownership state and removes managed resources through quarantine.
# When --help is passed, prints the uninstall subcommand usage instead.
#
# @arg $@ string Uninstall arguments.
# @exitcode 0 When the installation is removed.
# @exitcode 1 When confirmation, validation, or cleanup fails.
# @exitcode 2 When an argument is invalid.
# @see pixied_uninstall_usage
pixied_uninstall() {
    case " $* " in
    *" --help "* | *" -h "* | *" -help "*)
        if [ "$#" -eq 1 ]; then
            pixied_uninstall_usage
            return "$PIXIED_EXIT_OK"
        fi
        ;;
    esac
    pixied_uninstall_run "$@"
}

# @description The main entry point of the pixied command.
# Interprets the first argument as a command name and dispatches to the
# matching handler.
#
# @arg $@ string The command name and its arguments
# @exitcode 0 On success
# @exitcode 2 When an unknown command is given
# @see pixied_shell
# @see pixied_run_command
# @see pixied_install
# @see pixied_hook
# @see pixied_generate
# @see pixied_uninstall
# @see pixied_usage
pixied_main() {
    local command_name=${1:-}
    case "$command_name" in
    "")
        pixied_shell
        ;;
    shell)
        shift
        pixied_shell "$@"
        ;;
    run)
        shift
        pixied_run_command "$@"
        ;;
    install)
        shift
        pixied_install "$@"
        ;;
    hook)
        shift
        pixied_hook "$@"
        ;;
    generate)
        shift
        pixied_generate "$@"
        ;;
    __runtime-state)
        [ "$#" -eq 1 ] || pixied_die "internal runtime state command takes no arguments" "$PIXIED_EXIT_USAGE"
        pixied_runtime_dump_state
        ;;
    __machine-id)
        [ "$#" -eq 1 ] || pixied_die "internal machine id command takes no arguments" "$PIXIED_EXIT_USAGE"
        pixied_machine_id
        ;;
    uninstall)
        shift
        pixied_uninstall "$@"
        ;;
    help | -h | --help) pixied_usage ;;
    version | --version) printf 'pixied %s\n' "$PIXIED_VERSION" ;;
    *) pixied_die "unknown command: $command_name" "$PIXIED_EXIT_USAGE" ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    pixied_main "$@"
fi
